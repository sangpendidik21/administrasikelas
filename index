<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal GTK Jateng - Dashboard Utama</title>
    <script src="https://tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cloudflare.com">
</head>
<body class="bg-gray-100 font-sans">

    <!-- Navbar -->
    <nav class="bg-blue-800 text-white p-4 shadow-lg sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <img src="https://wikimedia.org" alt="Logo" class="h-10">
                <span class="font-bold text-lg tracking-wide uppercase">GTK Jawa Tengah</span>
            </div>
            <div class="hidden md:flex space-x-6">
                <a href="#" class="hover:text-blue-200">Beranda</a>
                <a href="#" class="hover:text-blue-200">Profil</a>
                <a href="#" class="hover:text-blue-200">Layanan</a>
                <a href="#" class="bg-yellow-500 px-4 py-2 rounded-lg font-semibold hover:bg-yellow-400">Login SIMPKB</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section / Statistik Singkat -->
    <header class="bg-blue-700 text-white py-12 px-4">
        <div class="container mx-auto text-center">
            <h1 class="text-3xl md:text-4xl font-extrabold mb-4">Pusat Informasi Guru & Tenaga Kependidikan</h1>
            <p class="text-blue-100 mb-8">Data Terintegrasi Provinsi Jawa Tengah</p>
            
            <!-- Widget Statistik -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
                <div class="bg-white/10 p-4 rounded-lg backdrop-blur-sm">
                    <div class="text-2xl font-bold">185.204</div>
                    <div class="text-sm">Total Guru</div>
                </div>
                <div class="bg-white/10 p-4 rounded-lg backdrop-blur-sm">
                    <div class="text-2xl font-bold">45.102</div>
                    <div class="text-sm">Tendik</div>
                </div>
                <div class="bg-white/10 p-4 rounded-lg backdrop-blur-sm">
                    <div class="text-2xl font-bold">12.430</div>
                    <div class="text-sm">Sekolah</div>
                </div>
                <div class="bg-white/10 p-4 rounded-lg backdrop-blur-sm">
                    <div class="text-2xl font-bold">35</div>
                    <div class="text-sm">Kab/Kota</div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Features -->
    <main class="container mx-auto py-10 px-4">
        <h2 class="text-2xl font-bold text-gray-800 mb-6 border-l-4 border-blue-800 pl-3">Layanan Utama GTK</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Card 1 -->
            <div class="bg-white p-6 rounded-xl shadow-sm border hover:shadow-md transition cursor-pointer">
                <div class="text-blue-600 text-3xl mb-4"><i class="fas fa-id-card"></i></div>
                <h3 class="font-bold text-lg mb-2">Cek NUPTK</h3>
                <p class="text-gray-600 text-sm">Validasi data NUPTK secara online langsung ke database pusat.</p>
            </div>
            <!-- Card 2 -->
            <div class="bg-white p-6 rounded-xl shadow-sm border hover:shadow-md transition cursor-pointer">
                <div class="text-green-600 text-3xl mb-4"><i class="fas fa-graduation-cap"></i></div>
                <h3 class="font-bold text-lg mb-2">PPG Dalam Jabatan</h3>
                <p class="text-gray-600 text-sm">Informasi pendaftaran dan seleksi administrasi sertifikasi guru.</p>
            </div>
            <!-- Card 3 -->
            <div class="bg-white p-6 rounded-xl shadow-sm border hover:shadow-md transition cursor-pointer">
                <div class="text-yellow-600 text-3xl mb-4"><i class="fas fa-chart-line"></i></div>
                <h3 class="font-bold text-lg mb-2">E-Kinerja</h3>
                <p class="text-gray-600 text-sm">Pelaporan kinerja harian dan penilaian bulanan ASN GTK.</p>
            </div>
        </div>

        <!-- Berita / Informasi Section -->
        <div class="mt-12">
            <h2 class="text-2xl font-bold text-gray-800 mb-6 border-l-4 border-blue-800 pl-3">Berita Terkini</h2>
            <div class="bg-white rounded-lg p-6 shadow-sm flex flex-col md:flex-row items-center gap-6">
                <img src="https://unsplash.com" alt="News" class="w-full md:w-48 h-32 object-cover rounded-lg">
                <div>
                    <span class="text-xs text-blue-600 font-bold uppercase">Kegiatan</span>
                    <h3 class="text-xl font-bold mt-1">Pembukaan Diklat Guru Penggerak Angkatan 10 Se-Jateng</h3>
                    <p class="text-gray-500 text-sm mt-2">Upaya meningkatkan kualitas pendidik melalui program transformasi kepemimpinan pendidikan...</p>
                    <button class="mt-4 text-blue-800 font-semibold hover:underline">Baca Selengkapnya &rarr;</button>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 text-gray-300 py-8 mt-12">
        <div class="container mx-auto text-center px-4">
            <p class="mb-2">&copy; 2024 Dinas Pendidikan dan Kebudayaan Provinsi Jawa Tengah</p>
            <p class="text-sm">Bidang Pembinaan Pendidik dan Tenaga Kependidikan</p>
        </div>
    </footer>

</body>
</html>
